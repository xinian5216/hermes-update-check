__pycache__/
*.py[cod]
*.egg-info/

# uv may materialise a lock file when someone runs `uv run` here; the project itself
# is pip/pyproject based, so it is not part of the repository.
uv.lock
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.coverage
htmlcov/
*.log

# local configuration and runtime state (never publish)
config.yaml
!config.example.yaml
update_state.json
watch_state.json
*.state.json
*.sqlite3
*.db

# secrets and credentials (never publish)
# NOTE: keep these patterns file-shaped. A bare `*_secret*` also matches source files
# such as tests/test_scan_secrets.py, which silently kept them out of the repository.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
secrets.json
secrets.yaml
secrets.yml
secrets.txt
*.secret
*.secrets
*_secrets.json
*_secrets.yaml
*_secrets.yml
credentials.json
credentials.yaml
credentials.yml
*_token.json

.DS_Store
Thumbs.db
